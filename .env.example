# Copy this file to .env and fill in the token. .env is ignored by git.
#
# Speaker separation needs a Hugging Face read token with the pyannote speaker
# diarization models accepted. Without it everything else still works; only the
# speaker labels are skipped.
#
#   1. Create a read token at https://huggingface.co/settings/tokens
#   2. Accept the conditions on:
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/segmentation-3.0
#
HF_TOKEN=
